export default function App(){const [open,setOpen]=useState(false),[photo,setPhoto]=useState(null),[form,setForm]=useState({name:'',email:'',phone:'',service:'',date:'',city:'',notes:''}),[sent,setSent]=useState(false);const change=e=>setForm({...form,[e.target.name]:e.target.value});const submit=e=>{e.preventDefault();const m=`Hola Paty Lu, quiero solicitar una cita.\nNombre: ${form.name}\nCorreo: ${form.email}\nWhatsApp: ${form.phone}\nServicio: ${form.service}\nFecha preferida: ${form.date}\nCiudad: ${form.city||'No especificada'}\nNotas: ${form.notes||'Sin notas'}`;window.open(wa(m),'_blank','noopener,noreferrer');setSent(true)};
return <><header><a className="brand" href="#inicio"><b>P</b>Paty Lu Make Up</a><button className="hamb" onClick={()=>setOpen(!open)} aria-label="Menú">{open?<X/>:<Menu/>}</button><nav className={open?'show':''}>{[['INICIO','#inicio'],['SERVICIOS','#servicios'],['PAQUETES','#paquetes'],['CATÁLOGO','#catalogo'],['CONTACTO','#contacto']].map(([t,h])=><a href={h} onClick={()=>setOpen(false)} key={h}>{t}</a>)}<a className="navbtn" href="#reserva" onClick={()=>setOpen(false)}>RESERVA</a></nav></header>
<section className="hero" id="inicio"><div className="herotxt"><small><Sparkles size={14}/> BELLEZA CON INTENCIÓN</small><h1>Elegancia en <i>cada detalle</i></h1><p>Maquillaje y peinado profesional para resaltar tu belleza en los momentos que merecen ser inolvidables.</p><a className="btn" href="#reserva">RESERVA TU CITA <ArrowUpRight size={16}/></a><a className="link" href="#catalogo">VER PORTAFOLIO</a></div><div className="heroimg"><img src="/images/novia-ramo.jpg"/><span>MAKEUP ARTIST<br/><strong>Paty Lu</strong></span></div><div className="herofoot">GUANAJUATO, GTO. <span>MAQUILLAJE · PEINADO · NOVIAS</span><span>01 — 11</span></div></section>
